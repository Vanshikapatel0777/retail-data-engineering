# ============================================================
# Retail Data Engineering Pipeline — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# --- PostgreSQL connection ---
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retail_dw

# --- Pipeline behavior ---
# Set to "true" to skip PostgreSQL loading and only produce local Parquet files
LOCAL_ONLY=false

# --- Source data ---
# Path to the Kaggle Excel file, relative to the project root
RAW_FILE=data/raw/online_retail_II.xlsx

# --- Azure Data Lake Storage Gen2 (optional) ---
# Leave blank to disable cloud upload
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=retail-data
AZURE_STORAGE_CONNECTION_STRING=

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
